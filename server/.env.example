PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/artistic_fusion?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=artistic_fusion_secure_jwt_token_change_me
JWT_EXPIRES_IN=7d

# Cloudinary Direct Upload Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Frontend Storefront Origin (CORS & On-Demand ISR)
CLIENT_URL=http://localhost:3000
REVALIDATION_SECRET=artistic_fusion_isr_secret_token

# Optional Production Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
